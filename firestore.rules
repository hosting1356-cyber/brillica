rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'hosting1356@gmail.com' && 
        request.auth.token.email_verified == true
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }

    function isValidConversation(data) {
      return data.keys().hasAll(['createdAt']) &&
             data.keys().size() <= 3 &&
             data.createdAt == request.time &&
             (data.get('status', 'active') in ['active', 'closed']);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'role', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.text is string && data.text.size() <= 5000 &&
             data.role in ['user', 'bot'] &&
             data.createdAt == request.time;
    }

    match /conversations/{conversationId} {
      allow create: if isValidId(conversationId) && isValidConversation(incoming());
      allow get, list: if isAdmin();
      
      match /messages/{messageId} {
        allow create: if isValidId(messageId) && isValidMessage(incoming());
        allow list: if isAdmin();
      }
    }
  }
}
